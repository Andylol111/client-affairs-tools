{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDeploymentStack",
      "Effect": "Allow",
      "Action": "cloudformation:DescribeStacks",
      "Resource": "arn:aws:cloudformation:us-east-1:442429446212:stack/YucgOutreach-dev/a33f6900-abdd-11f1-97bb-0affec64eb8b"
    },
    {
      "Sid": "AuthenticateEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushVerifiedImage",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:us-east-1:442429446212:repository/cdk-hnb659fds-container-assets-442429446212-us-east-1"
    },
    {
      "Sid": "RunDeploymentOnExistingHost",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:us-east-1:442429446212:instance/i-09a071e22270b027c",
        "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
      ]
    },
    {
      "Sid": "ReadDeploymentCommandResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
