# Copy into /etc/yucg/backup.env owned by root:root mode0600 only after approval.
# No static AWS credentials: the existing instance role supplies scoped S3 access.
BACKUP_UPLOAD_APPROVED=false
BACKUP_BUCKET=replace-with-approved-private-backup-bucket
AWS_DEFAULT_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=false
